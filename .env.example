# Frontend environment variables (Vite). Copy to `.env` for local dev.
# Only VITE_-prefixed vars are exposed to the browser.

# Base URL of the Guru NestJS backend.
# The frontend dev server runs on port 3000, so run the backend on 4000
# (set PORT=4000 in the backend's own .env) to avoid a port clash.
VITE_API_BASE_URL=localhost:4000

# Branch the order is placed against (backend `branches.id`, bigint).
VITE_DEFAULT_BRANCH_ID=1
